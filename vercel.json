{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/checkin-school-g1",
      "destination": "/checkin-school",
      "permanent": false
    },
    {
      "source": "/checkin-school-g2",
      "destination": "/checkin-school",
      "permanent": false
    },
    {
      "source": "/checkin-school-g3",
      "destination": "/checkin-school",
      "permanent": false
    },
    {
      "source": "/checkin-school-g4",
      "destination": "/checkin-school",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'none'; form-action 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; media-src 'none'; img-src 'self' data: blob:; font-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
