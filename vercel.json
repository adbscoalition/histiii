{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/questions.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=31536000, immutable" }
      ]
    }
  ]
}
